# ==========================================
# Polymarket 5-Minute Trading Bot Config
# ==========================================

# Trading Mode: set to false for real capital execution
PAPER_TRADING=true

# Polymarket Polygon Wallet / Credentials
# NEVER share your private key or commit .env to public repos!
POLY_PRIVATE_KEY=your_private_key_here
POLY_CLOB_API_KEY=your_clob_api_key_here
POLY_CLOB_SECRET=your_clob_secret_here
POLY_CLOB_PASSPHRASE=your_clob_passphrase_here

# Chain & Host
CHAIN_ID=137
CLOB_API_HOST=https://clob.polymarket.com
CLOB_WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Target Asset for 5m Markets: BTC, ETH, SOL
TARGET_ASSET=BTC

# Risk Parameters
MAX_POSITION_USD=25.0
MAX_DAILY_LOSS_USD=50.0
SLIPPAGE_TOLERANCE=0.02
KELLY_FRACTION=0.25

# Spot Reference Price Feed (e.g., binance, coinbase)
SPOT_EXCHANGE=binance

# ==========================================
# Alerts (optional -- leave blank to disable a channel)
# ==========================================
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Telegram: message @BotFather -> /newbot -> copy the token it gives you.
# Chat ID: message your new bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Which events to alert on (all default true; set to false to quiet any of them)
NOTIFY_ON_STARTUP=true
NOTIFY_ON_CONNECTIVITY_FAILURE=true
NOTIFY_ON_TRADE=true
NOTIFY_ON_SETTLEMENT=true
NOTIFY_ON_ROLLUP=true
NOTIFY_ON_CRASH=true